{
  "name": "dsh-scriptflow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Turn one Douyin link into a watermark-free mp4 plus a plain-text Word script, with DeepSeek proofreading. Host-only DSH plugin.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "engine",
    "docs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
